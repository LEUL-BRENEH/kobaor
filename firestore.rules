rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Product catalog: allow read and write
    match /koba_catalog/{document=**} {
      allow read, write: if true;
    }

    // Social media links: allow read and write
    match /koba_social/{document=**} {
      allow read, write: if true;
    }

    // Store settings: allow read and write
    match /koba_settings/{document=**} {
      allow read, write: if true;
    }

    // Orders: allow create, read, update, delete
    match /koba_orders/{document=**} {
      allow read, write: if true;
    }
  }
}
